# FULLHOME ID Environment Configuration
# Copy to .env.local for development, or set these in your host's dashboard.

# ─── Public (exposed to the browser) ──────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://fullhome.id
NEXT_PUBLIC_WHATSAPP_NUMBER=6281237533193
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE="Halo FULLHOME ID, Saya ingin berkonsultasi mengenai kebutuhan interior."

# ─── Server-only ──────────────────────────────────────────────────────────────
# Optional second photo library, e.g. an external drive on the studio machine.
# Leave unset in production — the app reads Portofolio/FULLHOME from the repo.
# Any path listed here is added to the allowlist the image API validates against,
# so point it only at a directory that may be served publicly.
# PORTFOLIO_EXTERNAL_ROOT=F:\KONTEN
